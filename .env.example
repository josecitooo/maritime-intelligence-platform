# ══════════════════════════════════════════════════════════════════════
#  Maritime Intelligence Platform — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ══════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=pretty                  # pretty | json

# ── AIS data source ───────────────────────────────────────────────────
# Free key → https://aisstream.io/account (GitHub login)
# NOTE: AISHub requires operating a physical AIS receiver, so it is not
# usable here. See docs/ingestion.md for the AISProvider extension point.
AISSTREAM_API_KEY=
AISSTREAM_ENDPOINT=wss://stream.aisstream.io/v0/stream

# ── Region (bounding box) — default: Gulf + Caribbean ─────────────────
# Chosen from measured coverage, not preference: the Caribbean basin alone
# yields 0.4 msg/s, extending to the Gulf raises it to 5.9 msg/s with the
# same subscription. See docs/ingestion.md §2.
MIN_LAT=8.0
MAX_LAT=31.0
MIN_LON=-98.0
MAX_LON=-59.0

# ── Database — Supabase direct Postgres connection ────────────────────
# Use the "Session pooler" (port 5432) or direct connection string from
# Supabase → Project Settings → Database. Always with sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Pipeline ──────────────────────────────────────────────────────────
RETENTION_DAYS=7
INGESTION_INTERVAL_MINUTES=30      # flush cadence (also the UI "updated every N minutes")
POSITION_INTERVAL_MINUTES=10       # per-vessel throttle — controls table growth
BUFFER_MAX_MESSAGES=200000         # hard cap on the in-memory buffer

# ── Historical export ─────────────────────────────────────────────────
EXPORT_DIR=historical
EXPORT_CSV=false
# Optional rclone remote for OneDrive upload, e.g. "institutional:/Maritime"
# Leave empty to write files locally only. See docs/deployment.md.
RCLONE_REMOTE=

# ── API ───────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
API_READ_KEY=
