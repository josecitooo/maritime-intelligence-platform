# ══════════════════════════════════════════════════════════════════════
#  Maritime Intelligence Platform — environment template
#  Copy to `.env` and fill in. NEVER commit `.env`.
# ══════════════════════════════════════════════════════════════════════

# ── Runtime ────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=pretty                  # pretty | json

# ── AIS data source ───────────────────────────────────────────────────
# Free key → https://aisstream.io/account (GitHub login)
# NOTE: AISHub requires operating a physical AIS receiver, so it is not
# usable here. See docs/ingestion.md for the AISProvider extension point.
AISSTREAM_API_KEY=
AISSTREAM_ENDPOINT=wss://stream.aisstream.io/v0/stream
# Which AIS messages to receive. Class B positions (types 18/19) carried 19.5%
# of the stream; type 5 alone is Class A only, so type 24 is what gives Class B
# a ship type and dimensions. See docs/ingestion.md §9 for what each carries.
MESSAGE_TYPES=PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData,StaticDataReport

# ── Region selection — the tracked_regions catalog ──────────────────────
# The boxes live in the `tracked_regions` table (seeded by migration). The
# browser toggles them via `PUT /regions`; the worker re-reads the enabled
# set on this cadence and replaces the stream subscription when it changed.
# MIN_LAT/MAX_LAT/MIN_LON/MAX_LON below remain as the *legacy default box*:
# a fresh database is seeded with exactly this region enabled, and the
# settings-derived box is what `/health` reports until the frontend switches
# to the catalog. See docs/ingestion.md.
MIN_LAT=8.0
MAX_LAT=31.0
MIN_LON=-98.0
MAX_LON=-59.0
REGION_REFRESH_SECONDS=30            # how often the worker checks for selection changes

# ── Database — Supabase direct Postgres connection ────────────────────
# Use the "Session pooler" (port 5432) or direct connection string from
# Supabase → Project Settings → Database. Always with sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# ── Pipeline ──────────────────────────────────────────────────────────
RETENTION_DAYS=7
INGESTION_INTERVAL_MINUTES=30      # flush cadence (also the UI "updated every N minutes")
POSITION_INTERVAL_MINUTES=10       # per-vessel throttle — controls table growth
BUFFER_MAX_MESSAGES=200000         # hard cap on the in-memory buffer

# ── Historical export ─────────────────────────────────────────────────
EXPORT_DIR=historical
EXPORT_CSV=false
# How often the archive is written and old rows are pruned. 1440 = daily,
# so retention is really 7–8 days: the interval is the last day of it.
MAINTENANCE_INTERVAL_MINUTES=1440
# Optional rclone remote for OneDrive upload, e.g. "institutional:/Maritime"
# Leave empty to write files locally only. See docs/deployment.md.
RCLONE_REMOTE=

# ── API ───────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
API_READ_KEY=
# Guards PUT /regions only. Leave empty to keep writes *disabled* — the
# demo stack ships with an empty key and the region selector read-only
# until the operator sets one.
API_WRITE_KEY=
