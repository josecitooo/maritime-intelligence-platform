# Frontend environment — copied to `frontend/.env` (gitignored, like the root one).
#
# Both values are read by the browser, so they ship inside the bundle and are
# public by construction. Neither is a secret: they point the client at an API
# and filter casual callers, they do not protect data. The API is open unless
# `API_READ_KEY` is set on the server (docs/architecture.md §11).

# Base URL of the FastAPI service. Default matches `uvicorn` / docker compose.
VITE_API_URL=http://localhost:8000

# Value of the optional `X-API-Key` read header. Leave empty while the API
# runs without a key.
VITE_API_KEY=
